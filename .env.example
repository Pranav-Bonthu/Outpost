# Local development: a plain file works with no auth token.
#   DATABASE_URL="file:./dev.db"
#
# Production (Vercel + Turso): point at your Turso database instead.
#   DATABASE_URL="libsql://<your-db-name>-<your-org>.turso.io"
#   TURSO_AUTH_TOKEN="<token from `turso db tokens create <your-db-name>`>"
DATABASE_URL="file:./dev.db"
TURSO_AUTH_TOKEN=""

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Powers the resume/job gap-analysis feature (src/lib/resumeMatch.ts).
# Get a key from https://console.anthropic.com/ — set locally and in
# Vercel's project env vars for production.
ANTHROPIC_API_KEY=""
