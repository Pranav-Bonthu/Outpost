// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarPath   String?
  bio          String?
  resumeText   String?
  cvText       String?
  lastDeepDiveAt DateTime?
  characterId    String?
  characterColor String?
  createdAt    DateTime @default(now())

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  posts           Post[]
  comments        Comment[]
  reactions       Reaction[]
  goals           Goal[]
  resumeAnalyses  ResumeAnalysis[]
  fishCatches     FishCatch[]
  birdSightings   BirdSighting[]
}

model Group {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  members       User[]
  posts         Post[]
  goals         Goal[]
  points        GroupPoints?
  buildings     Building[]
  fishCatches   FishCatch[]
  birdSightings BirdSighting[]
}

enum PostTag {
  Application
  Referral
  Certification
  Project
  Networking
  Other
}

model Post {
  id           String   @id @default(cuid())
  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  groupId      String
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  text         String
  tag          PostTag
  optionalLink String?
  createdAt    DateTime @default(now())

  goalId String?
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)

  comments  Comment[]
  reactions Reaction[]
}

model Reaction {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

enum GoalPeriod {
  weekly
  monthly
}

enum GoalStatus {
  in_progress
  hit
  missed
}

model Goal {
  id          String     @id @default(cuid())
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  groupId     String
  group       Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  description   String
  period        GoalPeriod
  status        GoalStatus @default(in_progress)
  pointsAwarded Boolean    @default(false)
  dueDate       DateTime?
  color         String?
  progress      Int        @default(0)
  createdAt     DateTime   @default(now())

  posts Post[]
}

model GroupPoints {
  groupId String @id
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  points  Int    @default(0)
  money   Int    @default(0)
}

enum BuildingType {
  VILLAGE_CENTER
  ZOO
  ARENA
  CHICKEN_PLACE
  MUSIC_FESTIVAL
}

model Building {
  id              String       @id @default(cuid())
  groupId         String
  group           Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  type            BuildingType
  level           Int          @default(1)
  x               Int?
  y               Int?
  lastCollectedAt DateTime     @default(now())
  createdAt       DateTime     @default(now())

  @@unique([groupId, type])
}

model ResumeAnalysis {
  id             String   @id @default(cuid())
  authorId       String
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  resumeText     String
  cvText         String?
  jobText        String
  jobTitle       String?
  matchingSkills String // JSON-encoded string[]
  missingSkills  String // JSON-encoded string[]
  advice         String // JSON-encoded array of AdviceItem (kind, title, timeEstimate, text, resourceTitle, resourceUrl, resourceImageUrl)
  createdAt      DateTime @default(now())

  coverLetter    CoverLetter?
}

model CoverLetter {
  id               String    @id @default(cuid())
  resumeAnalysisId String    @unique
  resumeAnalysis   ResumeAnalysis @relation(fields: [resumeAnalysisId], references: [id], onDelete: Cascade)
  draftText        String
  critique         String? // JSON-encoded CoverLetterCritiqueResult (summary, feedback[]), null until first critique
  critiquedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

enum FishSpecies {
  BLUEGILL
  MINNOW
  CATFISH
  TROUT
  BASS
  PIKE
  STURGEON
  GOLDEN_KOI
  ANGLERFISH
  LEVIATHAN_EEL
}

enum BirdSpecies {
  SPARROW
  PIGEON
  ROBIN
  CARDINAL
  BLUE_JAY
  WOODPECKER
  BARN_OWL
  RED_TAILED_HAWK
  SNOWY_EGRET
  GOLDEN_PHOENIX_FINCH
}

// Shared per-group collection: one row per species ever unlocked by the
// group (not per catch attempt). Money is spent from the shared group pool
// regardless of who clicks, so catcherId is for attribution only.
model FishCatch {
  id        String      @id @default(cuid())
  groupId   String
  group     Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  catcherId String
  catcher   User        @relation(fields: [catcherId], references: [id], onDelete: Cascade)
  species   FishSpecies
  createdAt DateTime    @default(now())

  @@unique([groupId, species])
}

model BirdSighting {
  id        String      @id @default(cuid())
  groupId   String
  group     Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  catcherId String
  catcher   User        @relation(fields: [catcherId], references: [id], onDelete: Cascade)
  species   BirdSpecies
  createdAt DateTime    @default(now())

  @@unique([groupId, species])
}
