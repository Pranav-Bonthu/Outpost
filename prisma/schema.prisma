// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  posts    Post[]
  comments Comment[]
  goals    Goal[]
}

model Group {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  members   User[]
  posts     Post[]
  goals     Goal[]
  points    GroupPoints?
  buildings Building[]
}

enum PostTag {
  Application
  Referral
  Certification
  Project
  Networking
  Other
}

model Post {
  id           String   @id @default(cuid())
  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  groupId      String
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  text         String
  tag          PostTag
  optionalLink String?
  createdAt    DateTime @default(now())

  comments Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

enum GoalPeriod {
  weekly
  monthly
}

enum GoalStatus {
  in_progress
  hit
  missed
}

model Goal {
  id          String     @id @default(cuid())
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  groupId     String
  group       Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  description   String
  period        GoalPeriod
  status        GoalStatus @default(in_progress)
  pointsAwarded Boolean    @default(false)
  createdAt     DateTime   @default(now())
}

model GroupPoints {
  groupId String @id
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  points  Int    @default(0)
  money   Int    @default(0)
}

enum BuildingType {
  VILLAGE_CENTER
  ZOO
  ARENA
  CHICKEN_PLACE
  MUSIC_FESTIVAL
}

model Building {
  id              String       @id @default(cuid())
  groupId         String
  group           Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  type            BuildingType
  level           Int          @default(1)
  lastCollectedAt DateTime     @default(now())
  createdAt       DateTime     @default(now())

  @@unique([groupId, type])
}
